<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== "undefined" ? pageTitle : c.site.brandName %></title>
  <meta name="description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : c.site.footerAbout %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600;1,700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/styles.css" />
  <link rel="icon" href="/<%= c.site.logo %>" />
</head>
<body>

  <header class="site-header" id="header">
    <div class="container">
      <a href="/" class="brand" aria-label="<%= c.site.brandName %> — accueil">
        <img class="brand__logo" src="/<%= c.site.logo %>" alt="Logo <%= c.site.brandName %>" />
        <span class="brand__name"><%= c.site.brandName %><small><%= c.site.brandTagline %></small></span>
      </a>
      <nav class="nav" id="nav">
        <a href="/"<%= page === "home" ? ' class="active"' : "" %>>À propos</a>
        <a href="/services"<%= page === "services" ? ' class="active"' : "" %>>Services</a>
        <a href="/expertise"<%= page === "expertise" ? ' class="active"' : "" %>>Expertise</a>
        <a href="/actualites"<%= page === "actualites" ? ' class="active"' : "" %>>Actualités</a>
        <a href="/carrieres"<%= page === "carrieres" ? ' class="active"' : "" %>>Carrières</a>
        <a href="/contact" class="btn btn--gold nav__cta<%= page === "contact" ? " active" : "" %>">Nous contacter</a>
      </nav>
      <button class="nav-toggle" id="navToggle" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
