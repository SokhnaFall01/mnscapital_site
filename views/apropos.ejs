<% var pageTitle = c.site.brandName + " — À propos"; %>
<%- include("partials/header", { c: c, page: page, pageTitle: pageTitle }) %>

  <!-- ================= HERO / PRÉSENTATION ================= -->
  <section class="hero">
    <div class="hero__bg"><img src="/<%= c.apropos.heroImage %>" alt="<%= c.site.brandName %>" /></div>
    <div class="container">
      <div class="hero__inner reveal">
        <span class="hero__eyebrow">À propos</span>
        <p class="hero__statement"><%= c.apropos.presentation %></p>
        <div class="hero__actions">
          <a href="/services" class="btn btn--gold">Nos services
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/contact" class="btn btn--outline"><%= c.contact.ctaLabel %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= POSITIONNEMENT ================= -->
  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Positionnement</span>
      </div>
      <p class="lead-text reveal"><%= c.apropos.positionnement %></p>
    </div>
  </section>

  <!-- ================= MISSION & VISION ================= -->
  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        <div class="card reveal">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <span class="kicker">Mission</span>
          <p class="card__text"><%= c.apropos.mission %></p>
        </div>
        <div class="card reveal">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <span class="kicker">Vision</span>
          <p class="card__text"><%= c.apropos.vision %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= APPROCHE ================= -->
  <section class="section section--navy">
    <div class="container">
      <div class="section-head section-head--left reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Approche</span>
      </div>
      <p class="lead-text reveal" style="color:rgba(255,255,255,.9)"><%= c.apropos.approche %></p>
    </div>
  </section>

  <!-- ================= CEO ================= -->
  <section class="section section--mist">
    <div class="container">
      <div class="split">
        <div class="ceo-photo reveal">
          <% if (c.apropos.ceoPhoto) { %>
            <img src="/<%= c.apropos.ceoPhoto %>" alt="<%= c.apropos.ceoName || c.apropos.ceoRole %>" />
          <% } else { %>
            <div class="ceo-photo__ph">
              <svg viewBox="0 0 24 24" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
          <% } %>
        </div>
        <div class="reveal">
          <div class="section-head section-head--left">
            <div class="gold-rule"></div>
            <span class="kicker">Présentation du CEO</span>
            <% if (c.apropos.ceoName) { %><h2><%= c.apropos.ceoName %></h2><% } %>
            <p class="ceo-role"><%= c.apropos.ceoRole %></p>
          </div>
          <p><%= c.apropos.ceoText %></p>
          <% if (c.apropos.signature) { %><p class="ceo-signature"><%= c.apropos.signature %></p><% } %>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= NOTRE PROMESSE ================= -->
  <section class="section section--navy">
    <div class="container">
      <div class="quote reveal">
        <div class="quote__head">
          <strong><%= c.site.brandName %></strong>
          <span>Notre promesse</span>
        </div>
        <span class="quote__mark">&ldquo;</span>
        <blockquote><%= c.apropos.promesse %></blockquote>
      </div>
    </div>
  </section>

  <!-- ================= PARTENAIRES ================= -->
  <% if (c.partners && c.partners.items && c.partners.items.length) { %>
  <section class="section" id="partenaires">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Partenaires</span>
        <h2><%= c.partners.title %></h2>
        <% if (c.partners.lead) { %><p><%= c.partners.lead %></p><% } %>
      </div>
      <div class="partners-grid reveal">
        <% c.partners.items.forEach(function(p){ %>
          <% if (p.url) { %>
            <a class="partner" href="<%= p.url %>" target="_blank" rel="noopener" title="<%= p.name %>"><img src="/<%= p.logo %>" alt="<%= p.name %>" loading="lazy" /></a>
          <% } else { %>
            <div class="partner" title="<%= p.name %>"><img src="/<%= p.logo %>" alt="<%= p.name %>" loading="lazy" /></div>
          <% } %>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

<%- include("partials/footer", { c: c }) %>
