<% var pageTitle = c.site.brandName + " — Nos services"; %>
<%- include("partials/header", { c: c, page: page, pageTitle: pageTitle }) %>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner reveal">
        <div class="breadcrumb"><a href="/">Accueil</a> &nbsp;/&nbsp; Nos services</div>
        <span class="kicker">Nos services</span>
        <p class="page-hero__lede"><%= c.services.intro %></p>
      </div>
    </div>
  </section>

  <!-- ================= LES 4 SERVICES ================= -->
  <section class="section section--mist">
    <div class="container">
      <div class="grid" style="gap:26px;">
        <% c.services.items.forEach(function(s, i){ %>
          <article class="expertise reveal">
            <div class="expertise__num"><%= String(i+1).padStart(2,'0') %></div>
            <div>
              <h3><%= s.title %></h3>
              <p class="expertise__lead"><%= s.presentation %></p>
              <ul class="expertise__points expertise__points--2col">
                <% s.prestations.forEach(function(pt){ %><li><%= pt %></li><% }); %>
              </ul>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= MODE D'INTERVENTION TRANSVERSAL ================= -->
  <section class="section section--navy">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Accompagnement</span>
        <h2><%= c.services.modeTitle %></h2>
      </div>
      <div class="timeline reveal">
        <% c.services.steps.forEach(function(st, i){ %>
          <div class="tstep tstep--dark"><div class="tstep__num"><%= String(i+1).padStart(2,'0') %></div><h3><%= st.title %></h3><p><%= st.text %></p></div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= APPEL À L'ACTION ================= -->
  <section class="section section--mist">
    <div class="container">
      <div class="cta-band">
        <a href="/contact" class="btn btn--gold"><%= c.contact.ctaLabel %>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

<%- include("partials/footer", { c: c }) %>
