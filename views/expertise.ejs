<% var pageTitle = c.site.brandName + " — Notre expertise · De la conception à la transformation"; %>
<%- include("partials/header", { c: c, page: page, pageTitle: pageTitle }) %>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner reveal">
        <div class="breadcrumb"><a href="/">Accueil</a> &nbsp;/&nbsp; Expertise</div>
        <span class="kicker">Notre expertise</span>
        <h1><%= c.expertise.heroTitle %></h1>
        <p><%= c.expertise.heroLede %></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2" style="gap:26px;">
        <% c.expertises.forEach(function(ex, i){ %>
          <article class="expertise reveal">
            <div class="expertise__num"><%= String(i+1).padStart(2,'0') %></div>
            <div>
              <h3><%= ex.title %></h3>
              <p class="expertise__lead"><%= ex.lead %></p>
              <ul class="expertise__points">
                <% ex.points.forEach(function(pt){ %><li><%= pt %></li><% }); %>
              </ul>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="split split--reverse">
        <div class="split__media reveal">
          <img src="/<%= c.expertise.differenceImage %>" alt="<%= c.expertise.differenceTitle %>" />
          <div class="split__badge"><strong>360°</strong><span>une lecture financière, stratégique et opérationnelle</span></div>
        </div>
        <div class="reveal">
          <div class="section-head section-head--left">
            <div class="gold-rule"></div>
            <span class="kicker">Notre différence</span>
            <h2><%= c.expertise.differenceTitle %></h2>
          </div>
          <p><%= c.expertise.differenceText %></p>
          <ul class="feature-list">
            <% c.expertise.features.forEach(function(f){ %>
              <li><strong><%= f.title %></strong><%= f.text %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Parcours d'accompagnement</span>
        <h2><%= c.expertise.parcoursTitle %></h2>
      </div>
      <div class="timeline reveal">
        <% c.expertise.parcours.forEach(function(st, i){ %>
          <div class="tstep"><div class="tstep__num"><%= String(i+1).padStart(2,'0') %></div><h3><%= st.title %></h3><p><%= st.text %></p></div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section section--navy">
    <div class="container">
      <div class="cta-band reveal">
        <h2>Rendez votre ambition finançable.</h2>
        <p>Discutons de la trajectoire la plus adaptée à votre projet et à votre marché.</p>
        <a href="/contact" class="btn btn--gold">Nous contacter
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

<%- include("partials/footer", { c: c }) %>
