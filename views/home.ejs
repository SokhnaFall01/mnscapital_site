<% var pageTitle = c.site.brandName + " — Le Cabinet · Ingénierie financière & stratégie en Afrique"; %>
<%- include("partials/header", { c: c, page: page, pageTitle: pageTitle }) %>

  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero__bg"><img src="/<%= c.home.heroImage %>" alt="MNS CAPITAL — conseil financier" /></div>
    <div class="container">
      <div class="hero__inner reveal">
        <span class="hero__eyebrow"><%= c.home.heroKicker %></span>
        <h1><%= c.home.heroTitle %></h1>
        <p class="hero__lede"><%= c.home.heroLede %></p>
        <div class="hero__actions">
          <a href="/services" class="btn btn--gold">Découvrir nos services
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/contact" class="btn btn--outline">Nous contacter</a>
        </div>
        <span class="hero__tagline"><%= c.site.motto.join(". ") %>.</span>
      </div>
    </div>
  </section>

  <!-- ================= DEVISE ================= -->
  <div class="motto">
    <div class="container">
      <div class="motto__row">
        <% c.site.motto.forEach(function(word, i){ %>
          <span class="motto__word"<%= i === c.site.motto.length - 1 ? '' : '' %>><% if (i === c.site.motto.length - 1) { %><span><%= word %></span><% } else { %><%= word %><% } %></span>
          <% if (i < c.site.motto.length - 1) { %><span class="motto__dot"></span><% } %>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- ================= NOTRE HISTOIRE ================= -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__media reveal">
          <img src="/<%= c.home.histoireImage %>" alt="<%= c.home.histoireTitle %>" />
          <div class="split__badge"><strong><%= c.home.histoireBadgeStrong %></strong><span><%= c.home.histoireBadgeText %></span></div>
        </div>
        <div class="reveal">
          <div class="section-head section-head--left">
            <div class="gold-rule"></div>
            <span class="kicker"><%= c.home.histoireKicker %></span>
            <h2><%= c.home.histoireTitle %></h2>
          </div>
          <p><%= c.home.histoirePara1 %></p>
          <p><%= c.home.histoirePara2 %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= VISION & MISSION ================= -->
  <section class="section section--mist">
    <div class="container">
      <div class="grid grid--2">
        <div class="card reveal">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <span class="kicker">Notre vision</span>
          <h3><%= c.home.visionTitle %></h3>
          <p><%= c.home.visionText %></p>
        </div>
        <div class="card reveal">
          <div class="card__icon">
            <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <span class="kicker">Notre mission</span>
          <h3><%= c.home.missionTitle %></h3>
          <p><%= c.home.missionText %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= NOS ENGAGEMENTS ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Nos engagements</span>
        <h2><%= c.home.engagementsTitle %></h2>
      </div>
      <div class="engagements reveal">
        <% c.home.engagements.forEach(function(txt, i){ %>
          <div class="engagement"><span class="engagement__num"><%= String(i+1).padStart(2,'0') %></span><p><%= txt %></p></div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= NOS VALEURS ================= -->
  <section class="section section--navy">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Nos valeurs</span>
        <h2><%= c.home.valeursTitle %></h2>
      </div>
      <div class="grid grid--3">
        <% c.home.valeurs.forEach(function(v, i){ %>
          <div class="value reveal"><span class="value__num"><%= String(i+1).padStart(2,'0') %></span><h3><%= v.title %></h3><p><%= v.text %></p></div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ================= NOTRE PROMESSE ================= -->
  <section class="section section--navy" style="padding-top:0;">
    <div class="container">
      <div class="quote reveal">
        <span class="quote__mark">&ldquo;</span>
        <blockquote><%= c.home.promesse %></blockquote>
        <cite><%= c.site.brandName %><span>Notre promesse</span></cite>
      </div>
    </div>
  </section>

  <!-- ================= PARTENAIRES ================= -->
  <% if (c.partners && c.partners.items && c.partners.items.length) { %>
  <section class="section" id="partenaires">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Partenaires</span>
        <h2><%= c.partners.title %></h2>
        <% if (c.partners.lead) { %><p><%= c.partners.lead %></p><% } %>
      </div>
      <div class="partners-grid reveal">
        <% c.partners.items.forEach(function(p){ %>
          <% if (p.url) { %>
            <a class="partner" href="<%= p.url %>" target="_blank" rel="noopener" title="<%= p.name %>">
              <img src="/<%= p.logo %>" alt="<%= p.name %>" loading="lazy" />
            </a>
          <% } else { %>
            <div class="partner" title="<%= p.name %>">
              <img src="/<%= p.logo %>" alt="<%= p.name %>" loading="lazy" />
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ================= APPEL À L'ACTION ================= -->
  <section class="section section--mist">
    <div class="container">
      <div class="cta-band" style="color:var(--ink)">
        <h2 style="color:var(--navy)"><%= c.home.ctaTitle %></h2>
        <p style="color:var(--silver)"><%= c.home.ctaText %></p>
        <a href="/contact" class="btn btn--gold">Prendre contact
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

<%- include("partials/footer", { c: c }) %>
