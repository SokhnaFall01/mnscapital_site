<% var pageTitle = c.site.brandName + " — Contact"; %>
<%- include("partials/header", { c: c, page: page, pageTitle: pageTitle }) %>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner reveal">
        <div class="breadcrumb"><a href="/">Accueil</a> &nbsp;/&nbsp; Contact</div>
        <span class="kicker">Contact</span>
        <p class="page-hero__lede"><%= c.contact.intro %></p>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="contact__grid">
        <div class="reveal">
          <div class="section-head section-head--left" style="margin-bottom:28px;">
            <div class="gold-rule"></div>
            <span class="kicker">Coordonnées</span>
          </div>
          <div class="contact__info-item">
            <span class="ic"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
            <div><h4>Ville &amp; pays</h4><p><%= c.contact.location %></p></div>
          </div>
          <div class="contact__info-item">
            <span class="ic"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></span>
            <div><h4>E-mail</h4><p><%= c.contact.email %></p></div>
          </div>
          <div class="contact__info-item">
            <span class="ic"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg></span>
            <div><h4>Téléphone</h4><p><%= c.contact.phone %></p></div>
          </div>
          <div class="contact__info-item">
            <span class="ic"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
            <div><h4>Disponibilité</h4><p><%= c.contact.availability %></p></div>
          </div>
        </div>

        <div class="form-card reveal">
          <% if (typeof sent !== "undefined" && sent) { %>
            <div style="padding:16px 18px;border-radius:10px;background:rgba(227,168,43,.12);color:var(--gold-dark);font-weight:600;margin-bottom:20px;">
              <%= c.contact.confirmation %>
            </div>
          <% } %>
          <form class="form" id="contactForm" method="POST" action="/contact" novalidate>
            <div>
              <label for="name">Nom et prénom</label>
              <input type="text" id="name" name="name" placeholder="Votre nom et prénom" required />
            </div>
            <div>
              <label for="org">Organisation</label>
              <input type="text" id="org" name="org" placeholder="Nom de l'organisation" />
            </div>
            <div>
              <label for="secteur">Secteur d'activités</label>
              <select id="secteur" name="secteur">
                <% c.contact.secteurs.forEach(function(s){ %><option value="<%= s %>"><%= s %></option><% }); %>
              </select>
            </div>
            <div class="row">
              <div>
                <label for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" placeholder="vous@organisation.com" required />
              </div>
              <div>
                <label for="phone">Téléphone</label>
                <input type="text" id="phone" name="phone" placeholder="Votre numéro" />
              </div>
            </div>
            <div>
              <label for="motif">Motif de contact</label>
              <select id="motif" name="motif">
                <% c.contact.motifs.forEach(function(m){ %><option value="<%= m %>"><%= m %></option><% }); %>
              </select>
            </div>
            <div>
              <label for="message">Message</label>
              <textarea id="message" name="message" placeholder="Votre message…" required></textarea>
            </div>
            <button type="submit" class="btn btn--navy"><%= c.contact.ctaLabel %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

<%- include("partials/footer", { c: c }) %>
