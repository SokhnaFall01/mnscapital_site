<% var pageTitle = c.site.brandName + " — Carrières · Construire des solutions qui comptent"; %>
<%- include("partials/header", { c: c, page: page, pageTitle: pageTitle }) %>

  <section class="page-hero">
    <div class="container">
      <div class="page-hero__inner reveal">
        <div class="breadcrumb"><a href="/">Accueil</a> &nbsp;/&nbsp; Carrières</div>
        <span class="kicker">Carrières</span>
        <h1><%= c.carrieres.heroTitle %></h1>
        <p><%= c.carrieres.heroLede %></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__media reveal">
          <img src="/<%= c.carrieres.cultureImage %>" alt="<%= c.carrieres.cultureTitle %>" />
          <div class="split__badge"><strong>Impact</strong><span>des missions au service du continent</span></div>
        </div>
        <div class="reveal">
          <div class="section-head section-head--left">
            <div class="gold-rule"></div>
            <span class="kicker">Notre culture</span>
            <h2><%= c.carrieres.cultureTitle %></h2>
          </div>
          <p><%= c.carrieres.culturePara1 %></p>
          <p><%= c.carrieres.culturePara2 %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head reveal">
        <div class="gold-rule"></div>
        <span class="kicker">Opportunités</span>
        <h2><%= c.carrieres.offersTitle %></h2>
      </div>

      <% if (c.carrieres.offers && c.carrieres.offers.length) { %>
        <div class="grid grid--2 reveal">
          <% c.carrieres.offers.forEach(function(job){ %>
            <article class="card">
              <h3><%= job.title %></h3>
              <p style="color:var(--gold-dark);font-weight:600;margin-bottom:12px;">
                <% if (job.location) { %><%= job.location %><% } %><% if (job.location && job.type) { %> · <% } %><% if (job.type) { %><%= job.type %><% } %>
              </p>
              <p><%= job.description %></p>
              <div style="margin-top:18px;">
                <a href="/contact?motif=carrieres" class="btn btn--ghost">Postuler</a>
              </div>
            </article>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state reveal">
          <div class="empty-state__icon">
            <svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3><%= c.carrieres.emptyTitle %></h3>
          <p><%= c.carrieres.emptyText %></p>
          <div style="margin-top:26px;">
            <a href="/contact?motif=carrieres" class="btn btn--navy">Soumettre une candidature
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      <% } %>
    </div>
  </section>

<%- include("partials/footer", { c: c }) %>
