# =========================================================================
# MNS CAPITAL — Variables d'environnement
# Copiez ce fichier en « .env » puis renseignez de vraies valeurs.
#   cp .env.example .env
# Le fichier .env n'est PAS versionné (voir .gitignore).
# =========================================================================

# Mot de passe de l'espace administrateur (/admin) — CHANGEZ-LE
ADMIN_PASSWORD=ChangezCeMotDePasse

# Clé secrète des sessions — collez une longue chaîne aléatoire.
# Générez-la avec :  openssl rand -hex 32
SESSION_SECRET=collez-ici-une-longue-chaine-aleatoire

# Port interne (laisser 3000 : c'est le port utilisé par Traefik)
PORT=3000
